# Local SQLite demo. Run commands from the repository root.
DATABASE_URL=sqlite:///./demo-only.db
# Generate a unique random value of at least 32 characters before starting.
JWT_SECRET=
COOKIE_SECURE=0
COMPANY_ID=qurlish
COMPANY_NAME=Qurlish Construction
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_SECONDS=1209600
# Opt in through the process environment only when seeding a NEW demo database.
DEMO_DATABASE_ONLY=0
DEMO_ADMIN_EMAIL=admin@example.test
# Supply passwords via process environment for one-time commands, not this file.
DEMO_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
